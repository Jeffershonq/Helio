# Copy to .env and fill in. Never commit .env.

# --- Required ---------------------------------------------------------------
POSTGRES_PASSWORD=change-me
# 32 random bytes as 64 hex characters:  openssl rand -hex 32
# Encrypts provider API keys. If you lose it, saved keys cannot be read again.
MASTER_KEY=

# --- App --------------------------------------------------------------------
# The public address of the app. Used in email links and for the same-origin check.
APP_URL=http://localhost:3000

# --- Email ------------------------------------------------------------------
# Docker uses Mailpit by default (http://localhost:8025). For real email, set your SMTP server.
# Without SMTP_HOST in development, emails are printed to the server log instead.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Helio <no-reply@helio.local>

# --- Google sign-in (optional) ----------------------------------------------
# Redirect URI to register in Google Cloud:  <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Shared model provider (the default for every workspace) -----------------
# Your central provider, for example your own 9Router. Every workspace uses it unless the workspace
# adds its own API key (optional, in Settings). The address is trusted because only you can set it here.
#   Helio in Docker, 9Router on the same computer:   http://host.docker.internal:20128/v1
#   Helio and 9Router on the same server (no Docker): http://localhost:20128/v1
PLATFORM_LLM_BASE_URL=
# Leave empty if your endpoint needs no key.
PLATFORM_LLM_API_KEY=
# Which model each tier uses on the shared provider (names as listed by GET <base url>/models).
# Light = Lyra, Medium = Carina, Heavy = Hydra. The fallback is tried if the main model fails.
PLATFORM_MODEL_LIGHT=
PLATFORM_MODEL_LIGHT_FALLBACK=
PLATFORM_MODEL_MEDIUM=
PLATFORM_MODEL_MEDIUM_FALLBACK=
PLATFORM_MODEL_HEAVY=
PLATFORM_MODEL_HEAVY_FALLBACK=
# Daily token limits on the shared provider, per workspace and per person (input + output). 0 = unlimited.
# Usage through a workspace's own API key never counts. To change one workspace in the database:
#   update "Workspace" set "dailyTokenLimitWorkspace" = 0 where slug = 'your-workspace';   (0 = unlimited)
PLATFORM_DAILY_TOKENS_WORKSPACE=1000000
PLATFORM_DAILY_TOKENS_USER=300000

# --- People's own API keys (optional feature) -------------------------------
# Lets an admin use a model provider on a private address (LiteLLM or Ollama on your LAN) as THEIR OWN key.
# Keep false on any install where untrusted people can create workspaces.
ALLOW_PRIVATE_PROVIDER_URLS=false

# --- Behind a reverse proxy -------------------------------------------------
# true only if your proxy overwrites X-Forwarded-For. Rate limits use this address.
TRUST_PROXY=true

# --- Local development without Docker (npm run dev) -------------------------
# DATABASE_URL=postgresql://helio:change-me@localhost:5432/helio
# REDIS_URL=redis://localhost:6379
