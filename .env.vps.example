# Settings for running Helio on a server next to your 9Router.
# Copy this file to .env on the server:   cp .env.vps.example .env
# Never commit .env and never paste real keys into chat.

# --- Secrets you create (on the server: openssl rand -hex 32) ----------------
POSTGRES_PASSWORD=
MASTER_KEY=

# --- How people open Helio ---------------------------------------------------
# Mode A, SSH tunnel (for testing, only you):   APP_URL=http://localhost:3000
#   then on your computer:  ssh -L 3000:127.0.0.1:3000 -L 8025:127.0.0.1:8025 ubuntu@YOUR_SERVER_IP
# Mode B, a domain with HTTPS (for real users): APP_URL=https://helio.example.com
#   and set HELIO_DOMAIN to the same name, then start with:  --profile https
APP_URL=http://localhost:3000
HELIO_DOMAIN=

# --- Your 9Router (the shared provider every workspace uses by default) -------
# 127.0.0.1 works because Helio shares the server's network (see docker-compose.vps.yml).
PLATFORM_LLM_BASE_URL=http://127.0.0.1:20128/v1
# The 9Router API key. Paste it here, on the server only.
PLATFORM_LLM_API_KEY=
# The model id for each tier, exactly as 9Router lists it. Find them with the command in VPS.md (step 4).
# Put quotes around a value that contains spaces.
PLATFORM_MODEL_LIGHT=
PLATFORM_MODEL_MEDIUM=
PLATFORM_MODEL_HEAVY=
# Optional fallbacks (a 9Router combo already falls back by itself, so you can leave these empty).
PLATFORM_MODEL_LIGHT_FALLBACK=
PLATFORM_MODEL_MEDIUM_FALLBACK=
PLATFORM_MODEL_HEAVY_FALLBACK=
# Daily token limits on the shared provider (input + output). 0 = unlimited.
PLATFORM_DAILY_TOKENS_WORKSPACE=1000000
PLATFORM_DAILY_TOKENS_USER=300000

# --- Email -------------------------------------------------------------------
# Default: Mailpit on this server (read mails at http://localhost:8025 through the tunnel).
# For real users, use a real SMTP service (for example your email provider's SMTP) and fill these in:
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Helio <no-reply@helio.local>

# --- Optional ----------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# People's own API keys must not point to private addresses. Keep false.
ALLOW_PRIVATE_PROVIDER_URLS=false
# true is right behind Caddy. (An SSH tunnel sends no forwarded address, which is fine.)
TRUST_PROXY=true
